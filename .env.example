# ---------------------------------------------------------------------------
# Aakash Men's Wear — environment (copy to .env.local)
# Never commit real secrets. Values here are development defaults.
# ---------------------------------------------------------------------------

# Secret used to sign session cookies. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-insecure-session-secret-change-me

# Absolute path of the sqlite database file (created by `npm run db:setup`).
DATABASE_PATH=./data/app.db

# Folder where admin-uploaded product images are stored on disk.
UPLOAD_DIR=./data/uploads

# Owner account created by `npm run db:seed` (skip with ADMIN_EMAIL= ).
ADMIN_NAME=Aakash Verma
ADMIN_EMAIL=admin@aakashmenswear.in
ADMIN_PASSWORD=Aakash@2026

# --- Customer login (mobile + OTP) ----------------------------------------
# The OTP transport is pluggable. `log` prints the code to the server console.
OTP_TRANSPORT=log
# In development/demo the API can also return the OTP so the flow is testable.
# This is ignored when NODE_ENV=production.
AUTH_DEMO_RETURN_OTP=true

# Optional real SMS provider (POST {to, message}). Leave empty to keep OTP offline.
# The token stays on the server only — it is never sent to the browser.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- Payments -------------------------------------------------------------
# Leave unset to keep "Online Payment" in integration-ready (disabled) mode.
# Razorpay keys are read server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public origin used for canonical URLs / Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
